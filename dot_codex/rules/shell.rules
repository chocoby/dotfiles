# Let auto_review handle general commands; keep explicit Claude exceptions.
allow_commands = [
    ["claude", "-p"],
    ["claude", "auth", "status"],
]

prompt_commands = [
    ["docker", "compose", "down"],
]

forbidden_commands = [
    ["find", "/"],
    ["sudo"],
    ["gh", "pr", ["close", "reopen", "review"]],
    ["gh", "release", ["create", "delete"]],
    ["gh", "repo", ["create", "fork", "delete"]],
    ["gh", "gist", "create"],
    ["gh", "auth", "login"],
    ["gh", "secret", ["set", "delete"]],
    ["gh", "variable", ["set", "delete"]],
]

for command in allow_commands:
    prefix_rule(pattern = command, decision = "allow")
for command in prompt_commands:
    prefix_rule(pattern = command, decision = "prompt")
for command in forbidden_commands:
    prefix_rule(pattern = command, decision = "forbidden")
